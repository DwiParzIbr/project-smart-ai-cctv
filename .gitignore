# Virtual Environment
.venv/
env/
venv/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets & Environment variables
.env
.env.local
.env.*.local
*.pem
*.key
service-account*.json
credentials*.json

# Databases
*.db
*.sqlite
*.sqlite3

# Storage media & binary records (clips, snapshots, uploads)
storage/clips/*
!storage/clips/.gitkeep
storage/snapshots/*
!storage/snapshots/.gitkeep
storage/plates/*
!storage/plates/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/backup_archive/*
storage/ultralytics/
storage/torch/

# YOLO & AI weights (downloaded automatically on runtime)
models/*.pt
models/*.onnx
!models/.gitkeep

# Vercel & IDE
.vercel/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Temporary scratch & tests
scratch/
test_*.jpg
latest_*.jpg
*.log
.vercel
